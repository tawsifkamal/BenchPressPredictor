{
  "manifest_version": 3,
  "name": "TinyGen",
  "version": "0.1.0",
  "description": "The Open Source AI-Powered Browser Code Editor",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
