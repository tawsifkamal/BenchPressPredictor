{
  "manifest_version": 3,
  "name": "tinygen",
  "version": "0.1.0",
  "description": "An AI-powered code editor in your browser.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
